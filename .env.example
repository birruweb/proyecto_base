# ==========================================================
# Configuración del proyecto. Copia este archivo como .env
# El .env NUNCA se sube a Git (tiene contraseñas).
# ==========================================================

APP_NAME="Proyecto Base"
# local = desarrollo, production = servidor real
APP_ENV=local
# true muestra el detalle de los errores. En producción: false
APP_DEBUG=true
APP_TIMEZONE=America/Mazatlan
# Opcional: fuerza la subcarpeta si la detección automática falla (ej. /proyecto-base)
APP_BASE_PATH=

# Base de datos (XAMPP: usuario root sin contraseña)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=proyecto_base
DB_USER=root
DB_PASS=

# Sesión: nombre de la cookie y minutos de inactividad antes de cerrarla
SESSION_NAME=proyecto_base_session
SESSION_LIFETIME=120
